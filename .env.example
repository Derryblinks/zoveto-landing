# Where the ZOVETO web application runs. Every "Log in" and "Create account" button links here.
# Local default matches the app's dev server.
VITE_APP_URL=http://localhost:3000

# Footer links. Leave each one empty until it exists: the footer then says it is not published
# yet instead of linking to a page that is missing. Addresses must start with https://, http://
# or a single "/".
VITE_PRIVACY_URL=
VITE_TERMS_URL=
VITE_SUPPORT_EMAIL=
