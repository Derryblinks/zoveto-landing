# Where the ZOVETO web application runs. Every "Log in" and "Create account" button links here.
# Local default matches the app's dev server.
VITE_APP_URL=http://localhost:3000

# Footer links. A draft privacy notice ships with the site at /privacy/ and is linked by default.
# Set VITE_PRIVACY_URL only to point at a notice published somewhere else. Leave the terms and
# support values empty until they exist: the footer then says they are not published yet instead
# of linking to a page that is missing. Addresses must start with https://, http:// or a single "/".
VITE_PRIVACY_URL=
VITE_TERMS_URL=
VITE_SUPPORT_EMAIL=
